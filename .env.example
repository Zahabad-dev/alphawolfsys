# Copia como .env.local para desarrollo; mismas variables en Easypanel para producción.

# Conexión a PostgreSQL (servicio dedicado "wolfbd" en el proyecto alphawolfsystem de Easypanel).
# En producción, usar el host interno (ej. alphawolfsystem_wolfbd:5432) — nunca exponer el puerto públicamente.
DATABASE_URL=

# Autenticación (NextAuth / Auth.js v5)
NEXTAUTH_URL=
AUTH_SECRET=

# Opcional: URL pública base para generar los QR (ej. https://alphawolfsystem.midominio.com).
# Si se omite, se detecta automáticamente del header Host de cada request.
NEXT_PUBLIC_APP_URL=
